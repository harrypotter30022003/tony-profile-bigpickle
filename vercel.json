{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/admin.html",
      "destination": "/admin.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron-fetch-news",
      "schedule": "0 0 * * 0"
    }
  ]
}