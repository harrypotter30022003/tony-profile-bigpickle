{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/rss.xml",
      "destination": "/api/data?type=rss"
    },
    {
      "source": "/api/rss",
      "destination": "/api/data?type=rss"
    },
    {
      "source": "/api/comments",
      "destination": "/api/data?type=comments"
    },
    {
      "source": "/api/reactions",
      "destination": "/api/data?type=reactions"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/admin.html",
      "destination": "/admin.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron-fetch-news",
      "schedule": "0 0 * * 0"
    }
  ]
}